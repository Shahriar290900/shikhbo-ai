# Bearer token all API clients must send — generate any random string
API_TOKEN=your-secret-token-here

# HuggingFace model ID for the LLM (vision-language model handles text + OCR)
LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# "cuda" for GPU Space (T4 Small recommended); "cpu" for CPU-only fallback
LLM_DEVICE=cuda

# Max tokens to generate per response — increase on GPU if answers are truncated
MAX_NEW_TOKENS=512

# Minimum reranker score to consider retrieval grounded (0–1)
CONFIDENCE_THRESHOLD=0.3

# Enable vision/OCR endpoint — requires GPU; set false on CPU Space
VISION_ENABLED=true

# HuggingFace token — required to download models from the Hub
HF_TOKEN=hf_your_token_here
