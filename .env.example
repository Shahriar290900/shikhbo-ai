# ─── HuggingFace Space AI Backend ────────────────────────────────────────────
# Bearer token — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set this SAME value in both this file AND web/.env as HF_API_TOKEN
API_TOKEN=your-secret-token-here

# HuggingFace model ID for the LLM + OCR (Qwen2.5-VL handles text AND vision)
LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# "cuda" for GPU Space (T4 Small recommended); "cpu" for CPU-only fallback
LLM_DEVICE=cuda

# Max tokens per response
MAX_NEW_TOKENS=512

# Minimum reranker confidence to count as grounded (0–1)
CONFIDENCE_THRESHOLD=0.3

# Enable vision/OCR endpoint — requires GPU
VISION_ENABLED=true

# HuggingFace token — needed to download gated models
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
