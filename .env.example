# Bearer token all API clients must send — generate any random string
API_TOKEN=your-secret-token-here

# HuggingFace model ID for the LLM.
# Smallest that actually loads on HF CPU Basic (2 vCPU, 16 GB RAM):
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# "cpu" for HF Spaces CPU Basic; "cuda" for GPU tier
LLM_DEVICE=cpu

# Max tokens to generate per response
MAX_NEW_TOKENS=512

# Minimum reranker score to consider retrieval grounded (0–1)
CONFIDENCE_THRESHOLD=0.3

# Set to "true" only on a GPU Space — CPU Basic cannot run the 7B vision model
VISION_ENABLED=false

# HuggingFace token — required to download models from the Hub
HF_TOKEN=hf_your_token_here
