# ─── Flask ───────────────────────────────────────────────────────────────────
# Random secret string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key_here

# ─── NeonDB (PostgreSQL) ──────────────────────────────────────────────────────
# Get from: https://console.neon.tech → New Project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI must include: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Gmail SMTP (for OTP emails) ──────────────────────────────────────────────
# Use your Gmail address + an App Password (NOT your real Gmail password)
# Enable 2FA first, then: Google Account → Security → App Passwords → Generate
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ─── HuggingFace Space (AI backend) ───────────────────────────────────────────
# URL of your HF Space: https://huggingface.co/spaces/shahriarhameem/shikhbo-ai
HF_SPACE_URL=https://shahriarhameem-shikhbo-ai.hf.space
# The API_TOKEN set in the HF Space secrets (any random string you chose)
HF_API_TOKEN=your_hf_space_api_token_here

# ─── Gemini (LLM fallback + OCR fallback) ────────────────────────────────────
# Used automatically when HF Space is sleeping. Model: gemma-4-31b-it
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── App config ───────────────────────────────────────────────────────────────
# Your app's public URL (used for OAuth redirect URIs)
APP_URL=http://localhost:5000
# Set to "production" on hosting
FLASK_ENV=development
